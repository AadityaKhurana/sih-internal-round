# Copy to frontend/.env.local and adjust. Vite only exposes VITE_* to the client.

# Transport switch. `true` = in-browser mock API + simulated WebSocket (fixtures,
# no backend needed). `false` = talk to the real FastAPI service.
VITE_USE_MOCK=true

# Base path for REST calls when VITE_USE_MOCK=false.
# Left as a relative path so the dev proxy in vite.config.ts handles the origin.
VITE_API_BASE_URL=/api

# WebSocket path for live alerts + live sightings when VITE_USE_MOCK=false.
VITE_WS_URL=/ws/live

# Where the dev proxy forwards /api and /ws (dev only, not exposed to the client).
VITE_PROXY_TARGET=http://localhost:8000

# Map default view (the simulated demo corridor).
VITE_MAP_CENTER_LAT=12.9752
VITE_MAP_CENTER_LNG=77.6100
VITE_MAP_ZOOM=14

# Carto basemap url with api key
VITE_CARTO_BASEMAP_URL=