        <mxCell id="e4" value="PlateSighting" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=block;strokeColor=#8a3b36;fontSize=10;fontColor=#8a3b36;exitX=0.4;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="PROD" target="REDIS">
