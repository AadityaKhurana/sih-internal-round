<mxfile host="app.diagrams.net" type="device">
  <diagram id="anpr-arch" name="ANPR Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="City-Wide ANPR Platform — System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a2733;" vertex="1" parent="1">
          <mxGeometry x="340" y="24" width="760" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Integrates at the PlateSighting event boundary — OCR (real) and the demo producer are interchangeable. Persistence aggregates per-approach cameras up to junctions." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#607080;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="840" height="24" as="geometry" />
        </mxCell>

