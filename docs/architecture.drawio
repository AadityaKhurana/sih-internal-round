        <mxCell id="CAMS" value="&lt;b&gt;Per-approach cameras&lt;/b&gt;&lt;br&gt;one per junction arm&lt;br&gt;incoming left carriageway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#12324f;shadow=1;" vertex="1" parent="1">
