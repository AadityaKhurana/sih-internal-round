<mxfile host="app.diagrams.net" type="device">
  <diagram id="anpr-arch" name="ANPR Architecture">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="1020" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="City-Wide ANPR Platform — System Architecture" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1a2733;" vertex="1" parent="1">
          <mxGeometry x="320" y="24" width="620" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="One PlateSighting event boundary: real OCR and the demo producer are interchangeable. The backend aggregates per-approach cameras up to junctions." style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#607080;" vertex="1" parent="1">
          <mxGeometry x="230" y="58" width="800" height="22" as="geometry" />
        </mxCell>

        <!-- ===== nodes (spine, top -> bottom) ===== -->
        <mxCell id="CAMS" value="&lt;b&gt;Per-approach cameras&lt;/b&gt;&lt;br&gt;one per junction arm · incoming left carriageway" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#12324f;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="110" width="300" height="58" as="geometry" />
        </mxCell>
        <mxCell id="OCR" value="&lt;b&gt;OCR worker — Lane A&lt;/b&gt;&lt;br&gt;YOLO + PaddleOCR + voting&lt;br&gt;&lt;i&gt;needs GPU / weights / video&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#12324f;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="212" width="240" height="74" as="geometry" />
        </mxCell>
        <mxCell id="PROD" value="&lt;b&gt;Producer — demo feed&lt;/b&gt;&lt;br&gt;synthetic corridor trips&lt;br&gt;(stands in for OCR)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#eef3fb;strokeColor=#6c8ebf;fontColor=#12324f;dashed=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="212" width="210" height="74" as="geometry" />
        </mxCell>

        <mxCell id="REDIS" value="&lt;b&gt;Redis — event bus&lt;/b&gt;&lt;br&gt;plate_sightings stream (consumer group + DLQ) · sightings:new / alerts:new pub·sub" style="shape=process;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=#5a2320;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="380" height="66" as="geometry" />
        </mxCell>

        <mxCell id="WORK" value="&lt;b&gt;Workers (Python)&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontColor=#3f6b2b;fillColor=#eef7ea;strokeColor=#82b366;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="448" width="420" height="150" as="geometry" />
        </mxCell>
        <mxCell id="PERS" value="&lt;b&gt;persistence&lt;/b&gt; — validate · camera→junction · upsert sightings/plates" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24401b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="468" y="486" width="384" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ALRT" value="&lt;b&gt;alerts&lt;/b&gt; — blacklist match + route-anomaly (travel-time feasibility)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24401b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="468" y="522" width="384" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ANAL" value="&lt;b&gt;analytics&lt;/b&gt; — 5-min camera &amp; link metric rollups" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#24401b;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="468" y="558" width="384" height="32" as="geometry" />
        </mxCell>

        <mxCell id="PG" value="&lt;b&gt;PostgreSQL + PostGIS&lt;/b&gt;&lt;br&gt;cameras(junctions) · approach_cameras · camera_links&lt;br&gt;roads · plates · sightings · blacklist · alerts · audit_logs · *_metrics_5m" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#6b4a00;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="650" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="&lt;b&gt;MinIO / S3&lt;/b&gt;&lt;br&gt;plate crops · clips" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#ffe6cc;strokeColor=#d79b00;fontColor=#6b4a00;fontSize=10;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="930" y="660" width="200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="API" value="&lt;b&gt;FastAPI backend&lt;/b&gt;&lt;br&gt;REST /api — cameras · camera-links · plates · trajectory · sightings · alerts · blacklist · analytics · reports&lt;br&gt;live publisher → WS /ws/live&lt;br&gt;&lt;i&gt;auth: X-Operator-Subject&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#3f2a52;fontSize=11;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="772" width="400" height="92" as="geometry" />
        </mxCell>

        <mxCell id="UI" value="&lt;b&gt;GIS Operations Dashboard&lt;/b&gt; — React + TypeScript + Leaflet&lt;br&gt;map · trajectory · alerts · analytics · reports · blacklist · live" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#6b5a00;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="902" width="400" height="58" as="geometry" />
        </mxCell>

        <mxCell id="CONTRACT" value="&lt;b&gt;anpr_common&lt;/b&gt;&lt;br&gt;PlateSighting contract&lt;br&gt;+ DB layer (shared)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#999999;fontColor=#333333;dashed=1;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="210" height="80" as="geometry" />
