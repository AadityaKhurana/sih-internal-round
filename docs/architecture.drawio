        <mxCell id="e5" value="shared contract" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;endArrow=open;strokeColor=#aaaaaa;fontSize=10;fontColor=#888888;exitX=1;exitY=0.6;entryX=0;entryY=0.3;" edge="1" parent="1" source="CONTRACT" target="REDIS"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="consume" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#555555;fontSize=10;fontColor=#555555;exitX=0.38;exitY=1;entryX=0.38;entryY=0;" edge="1" parent="1" source="REDIS" target="WORK"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="publish sightings:new · alerts:new" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;strokeColor=#b85450;fontSize=10;fontColor=#8a3b36;exitX=0.66;exitY=0;entryX=0.66;entryY=1;" edge="1" parent="1" source="WORK" target="REDIS">
