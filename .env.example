# Copy to .env and adjust. .env is git-ignored.
# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=local
API_PORT=8000

# Shared bearer token for the API. Set to enable auth (data endpoints require
# `Authorization: Bearer <token>`; the WebSocket uses ?token=<token>).
# Leave empty to DISABLE auth for local dev.
API_AUTH_TOKEN=dev-secret-change-me

# ---------------------------------------------------------------------------
# Connection URLs — the ONLY things you change to move to managed services.
# Hosts below (postgres / redis / minio) are the compose service names, which
# resolve from inside the compose network (i.e. from the api container).
# If you run the API on your host instead, use localhost.
# ---------------------------------------------------------------------------

# Local (compose):   postgresql://anpr:anpr@postgres:5432/anpr
# Supabase example:  postgresql://postgres:<PWD>@db.<REF>.supabase.co:5432/postgres?sslmode=require
DATABASE_URL=postgresql://anpr:anpr@postgres:5432/anpr

# Local (compose):   redis://redis:6379/0
# Upstash example:   rediss://default:<TOKEN>@<HOST>.upstash.io:6379
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Local Postgres container settings (ignored when using a managed DB)
# ---------------------------------------------------------------------------
POSTGRES_USER=anpr
POSTGRES_PASSWORD=anpr
POSTGRES_DB=anpr
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Local Redis container settings
# ---------------------------------------------------------------------------
REDIS_PORT=6379

# ---------------------------------------------------------------------------
# Object storage — MinIO locally, any S3-compatible store later
# ---------------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=anpr-media
S3_REGION=us-east-1
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
